# Cloudflare R2 S3-compatible credentials. Use an R2 API token with Object Read & Write.
R2_ACCOUNT_ID=your_cloudflare_account_id
# Alternatively set R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_bucket_name
R2_REGION=auto

# WebDAV login; use a long, unique password (12+ characters required).
WEBDAV_USERNAME=webdav
WEBDAV_PASSWORD=replace-this-with-a-long-random-password

HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO
# 0 = unlimited by app policy; uploads are spooled to disk before being sent to R2.
MAX_UPLOAD_MB=0
TMP_DIR=/tmp/r2-webdav
MAX_PROPFIND_ITEMS=10000
LOCK_TIMEOUT=3600
