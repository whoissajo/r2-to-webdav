# Copy this file to .env.sftp and fill it in.
# Keep .env.sftp private; never commit real credentials.

R2_ACCOUNT_ID=your_cloudflare_account_id
# Optional alternative to R2_ACCOUNT_ID:
# R2_ENDPOINT_URL=https://your_cloudflare_account_id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_bucket_name
R2_REGION=auto

SFTP_USERNAME=sftp
SFTP_PASSWORD=replace-with-a-long-random-password

HOST=0.0.0.0
PORT=2222
TMP_DIR=/tmp/r2-sftp
HOST_KEY_PATH=/data/ssh_host_rsa_key
MAX_UPLOAD_MB=0
MAX_DIRECTORY_ENTRIES=10000
LOG_LEVEL=INFO

# External host port; used only by docker-compose.sftp.yml.
SFTP_HOST_PORT=2222
